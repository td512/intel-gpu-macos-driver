@@ -151,6 +151,52 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
    return GetLastError() == ERROR_TIMEOUT ? ETIMEDOUT : -1;
 }
 
+#elif defined(__APPLE__)
+
+#include <assert.h>
+#include <errno.h>
+#include <limits.h>
+#include <time.h>
+#include <os/clock.h>
+#include <os/os_sync_wait_on_address.h>
+
+int futex_wake(uint32_t *addr, int32_t count)
+{
+   assert(count == 1 || count == INT32_MAX);
+   /* Fails with ENOENT when nobody waits, which is not an error here. */
+   if (count == 1)
+      os_sync_wake_by_address_any(addr, sizeof(*addr), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+   else
+      os_sync_wake_by_address_all(addr, sizeof(*addr), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+   return 0;
+}
+
+int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
+{
+   int ret;
+
+   if (timeout == NULL) {
+      ret = os_sync_wait_on_address(addr, (uint32_t)value, sizeof(*addr),
+                                    OS_SYNC_WAIT_ON_ADDRESS_NONE);
+   } else {
+      /* The timeout is absolute on CLOCK_MONOTONIC, like FUTEX_WAIT_BITSET. */
+      struct timespec now;
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      int64_t ns = (int64_t)(timeout->tv_sec - now.tv_sec) * 1000000000 +
+                   (timeout->tv_nsec - now.tv_nsec);
+      if (ns <= 0) {
+         errno = ETIMEDOUT;
+         return -1;
+      }
+      ret = os_sync_wait_on_address_with_timeout(addr, (uint32_t)value,
+                                                 sizeof(*addr),
+                                                 OS_SYNC_WAIT_ON_ADDRESS_NONE,
+                                                 OS_CLOCK_MACH_ABSOLUTE_TIME,
+                                                 ns);
+   }
+   return ret < 0 ? -1 : 0;
+}
+
 #else
 #error UTIL_FUTEX_SUPPORTED is not implemented but the header told it is supported on this platform
 #endif
