+/* IOSurface swapchains (wsi_device::iosurface) */
+
+#import <IOSurface/IOSurface.h>
+#import <CoreVideo/CoreVideo.h>
+#import <QuartzCore/CATransaction.h>
+
+static bool
+iosurface_format(VkFormat format, uint32_t *pixel_format, uint32_t *cpp)
+{
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+      *pixel_format = 'BGRA'; /* kCVPixelFormatType_32BGRA */
+      *cpp = 4;
+      return true;
+   default:
+      return false;
+   }
+}
+
+bool
+wsi_metal_iosurface_format_supported(VkFormat format,
+                                     VkColorSpaceKHR color_space)
+{
+   uint32_t pixel_format, cpp;
+   return iosurface_format(format, &pixel_format, &cpp) &&
+          color_space == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+}
+
+static void
+dict_set_u32(CFMutableDictionaryRef dict, CFStringRef key, uint32_t value)
+{
+   CFNumberRef n = CFNumberCreate(NULL, kCFNumberSInt32Type, &value);
+   CFDictionarySetValue(dict, key, n);
+   CFRelease(n);
+}
+
+void *
+wsi_metal_iosurface_create(uint32_t width, uint32_t height,
+                           VkFormat format, VkColorSpaceKHR color_space,
+                           uint32_t bytes_per_row, uint64_t alloc_size,
+                           uint32_t *id_out)
+{
+   uint32_t pixel_format, cpp;
+   if (!iosurface_format(format, &pixel_format, &cpp) ||
+       alloc_size > UINT32_MAX)
+      return NULL;
+
+   CFMutableDictionaryRef props =
+      CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                &kCFTypeDictionaryValueCallBacks);
+   dict_set_u32(props, kIOSurfaceWidth, width);
+   dict_set_u32(props, kIOSurfaceHeight, height);
+   dict_set_u32(props, kIOSurfaceBytesPerElement, cpp);
+   dict_set_u32(props, kIOSurfaceBytesPerRow, bytes_per_row);
+   dict_set_u32(props, kIOSurfaceAllocSize, (uint32_t)alloc_size);
+   dict_set_u32(props, kIOSurfacePixelFormat, pixel_format);
+   IOSurfaceRef surface = IOSurfaceCreate(props);
+   CFRelease(props);
+   if (!surface)
+      return NULL;
+
+   if (IOSurfaceGetBytesPerRow(surface) != bytes_per_row ||
+       IOSurfaceGetAllocSize(surface) < alloc_size) {
+      CFRelease(surface);
+      return NULL;
+   }
+
+   /* The pixels are sRGB-encoded: tag the surface so that the window server
+    * color-matches it like a CAMetalLayer drawable of the same format.
+    */
+   CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+   if (cs) {
+      CFDataRef icc = CGColorSpaceCopyICCData(cs);
+      if (icc) {
+         IOSurfaceSetValue(surface, CFSTR("IOSurfaceColorSpace"), icc);
+         CFRelease(icc);
+      }
+      CGColorSpaceRelease(cs);
+   }
+
+   *id_out = IOSurfaceGetID(surface);
+   return surface;
+}
+
+void
+wsi_metal_iosurface_release(void *iosurface)
+{
+   if (iosurface)
+      CFRelease((IOSurfaceRef)iosurface);
+}
+
+void *
+wsi_metal_iosurface_base_address(void *iosurface)
+{
+   return IOSurfaceGetBaseAddress((IOSurfaceRef)iosurface);
+}
+
+bool
+wsi_metal_iosurface_in_use(void *iosurface)
+{
+   return IOSurfaceIsInUse((IOSurfaceRef)iosurface);
+}
+
+struct wsi_metal_contents_layer {
+   CALayer *layer;
+};
+
+static NSString *const wsi_contents_layer_name = @"org.freedesktop.mesa.wsi.iosurface";
+
+struct wsi_metal_contents_layer *
+wsi_metal_contents_layer_get(const CAMetalLayer *metal_layer, bool opaque)
+{
+   struct wsi_metal_contents_layer *l = calloc(1, sizeof(*l));
+   if (!l)
+      return NULL;
+
+   @autoreleasepool {
+      CALayer *layer = nil;
+      for (CALayer *sub in metal_layer.sublayers) {
+         if ([sub.name isEqualToString:wsi_contents_layer_name]) {
+            layer = sub;
+            break;
+         }
+      }
+
+      [CATransaction begin];
+      [CATransaction setDisableActions:YES];
+      if (!layer) {
+         layer = [CALayer layer];
+         layer.name = wsi_contents_layer_name;
+         layer.anchorPoint = CGPointZero;
+         layer.frame = metal_layer.bounds;
+         layer.contentsScale = metal_layer.contentsScale;
+         layer.contentsGravity = kCAGravityResize;
+         layer.autoresizingMask = kCALayerWidthSizable | kCALayerHeightSizable;
+         [(CAMetalLayer *)metal_layer addSublayer:layer];
+      }
+      layer.opaque = opaque;
+      /* "opaque" is only a hint for layers that draw their own backing
+       * store: Core Animation still blends IOSurface contents by their
+       * alpha.  An OPAQUE composite-alpha swapchain must not show alpha
+       * (X11 depth-24 windows, NSOpenGL and an opaque CAMetalLayer ignore
+       * it), so mark the contents themselves opaque.
+       */
+      if ([layer respondsToSelector:@selector(setContentsOpaque:)])
+         [layer setValue:@(opaque) forKey:@"contentsOpaque"];
+      [CATransaction commit];
+      [CATransaction flush];
+
+      l->layer = [layer retain];
+   }
+
+   return l;
+}
+
+void
+wsi_metal_contents_layer_set(struct wsi_metal_contents_layer *l,
+                             void *iosurface)
+{
+   @autoreleasepool {
+      CALayer *layer = l->layer;
+      CALayer *super_layer = layer.superlayer;
+
+      [CATransaction begin];
+      [CATransaction setDisableActions:YES];
+      if (super_layer) {
+         /* Follow the window's size and backing scale (the swapchain is
+          * SUBOPTIMAL until the application recreates it).
+          */
+         const CGRect bounds = super_layer.bounds;
+         if (!CGRectEqualToRect(layer.frame, bounds))
+            layer.frame = bounds;
+         if (layer.contentsScale != super_layer.contentsScale)
+            layer.contentsScale = super_layer.contentsScale;
+      }
+      layer.contents = (id)iosurface;
+      [CATransaction commit];
+      /* Also commit an implicit transaction this thread may have open, so
+       * the frame goes to the window server now, not at the end of the
+       * thread's next run loop turn.
+       */
+      [CATransaction flush];
+   }
+}
+
+void
+wsi_metal_contents_layer_put(struct wsi_metal_contents_layer *l)
+{
+   if (!l)
+      return;
+   [l->layer release];
+   free(l);
+}
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+
+#include <errno.h>
+#include <pthread.h>
+#include <time.h>
+
+/* The latch thread runs tick() at every refresh the display link reports.
+ * Without a display link (no active display: the screen asleep, a headless
+ * session) or when its callbacks stop (display sleep), it ticks on its own
+ * every 1/60 s, so FIFO and MAILBOX swapchains keep moving.
+ */
+struct wsi_metal_vblank {
+   CVDisplayLinkRef link;
+   void (*tick)(void *data);
+   void *data;
+   pthread_t thread;
+   pthread_mutex_t mutex;
+   pthread_cond_t cond;
+   uint64_t refreshes;
+   bool stop;
+};
+
+#define WSI_METAL_VBLANK_FALLBACK_NS (1000000000ull / 60)
+
+static CVReturn
+wsi_metal_vblank_cb(CVDisplayLinkRef link, const CVTimeStamp *now,
+                    const CVTimeStamp *output_time, CVOptionFlags flags_in,
+                    CVOptionFlags *flags_out, void *ctx)
+{
+   struct wsi_metal_vblank *v = ctx;
+   pthread_mutex_lock(&v->mutex);
+   v->refreshes++;
+   pthread_cond_signal(&v->cond);
+   pthread_mutex_unlock(&v->mutex);
+   return kCVReturnSuccess;
+}
+
+static void *
+wsi_metal_vblank_thread(void *arg)
+{
+   struct wsi_metal_vblank *v = arg;
+   pthread_setname_np("mesa-wsi-vblank");
+   pthread_mutex_lock(&v->mutex);
+   while (!v->stop) {
+      const uint64_t seen = v->refreshes;
+      struct timespec ts;
+      clock_gettime(CLOCK_REALTIME, &ts);
+      uint64_t ns = (uint64_t)ts.tv_nsec + WSI_METAL_VBLANK_FALLBACK_NS +
+                    (v->link ? WSI_METAL_VBLANK_FALLBACK_NS : 0);
+      ts.tv_sec += ns / 1000000000ull;
+      ts.tv_nsec = ns % 1000000000ull;
+      while (!v->stop && v->refreshes == seen) {
+         if (pthread_cond_timedwait(&v->cond, &v->mutex, &ts) == ETIMEDOUT)
+            break;
+      }
+      if (v->stop)
+         break;
+      pthread_mutex_unlock(&v->mutex);
+      v->tick(v->data);
+      pthread_mutex_lock(&v->mutex);
+   }
+   pthread_mutex_unlock(&v->mutex);
+   return NULL;
+}
+
+struct wsi_metal_vblank *
+wsi_metal_vblank_start(void (*tick)(void *data), void *data)
+{
+   struct wsi_metal_vblank *v = calloc(1, sizeof(*v));
+   if (!v)
+      return NULL;
+   v->tick = tick;
+   v->data = data;
+   pthread_mutex_init(&v->mutex, NULL);
+   pthread_cond_init(&v->cond, NULL);
+
+   if (CVDisplayLinkCreateWithActiveCGDisplays(&v->link) == kCVReturnSuccess) {
+      CVDisplayLinkSetCurrentCGDisplay(v->link, CGMainDisplayID());
+      CVDisplayLinkSetOutputCallback(v->link, wsi_metal_vblank_cb, v);
+      if (CVDisplayLinkStart(v->link) != kCVReturnSuccess) {
+         CVDisplayLinkRelease(v->link);
+         v->link = NULL;
+      }
+   } else {
+      v->link = NULL;
+   }
+
+   if (pthread_create(&v->thread, NULL, wsi_metal_vblank_thread, v)) {
+      if (v->link) {
+         CVDisplayLinkStop(v->link);
+         CVDisplayLinkRelease(v->link);
+      }
+      pthread_cond_destroy(&v->cond);
+      pthread_mutex_destroy(&v->mutex);
+      free(v);
+      return NULL;
+   }
+   return v;
+}
+
+void
+wsi_metal_vblank_stop(struct wsi_metal_vblank *v)
+{
+   if (!v)
+      return;
+   /* CVDisplayLinkStop waits for the display link thread to finish its
+    * callback; then the latch thread finishes its tick and exits.
+    */
+   if (v->link) {
+      CVDisplayLinkStop(v->link);
+      CVDisplayLinkRelease(v->link);
+   }
+   pthread_mutex_lock(&v->mutex);
+   v->stop = true;
+   pthread_cond_signal(&v->cond);
+   pthread_mutex_unlock(&v->mutex);
+   pthread_join(v->thread, NULL);
+   pthread_cond_destroy(&v->cond);
+   pthread_mutex_destroy(&v->mutex);
+   free(v);
+}
+
+uint64_t
+wsi_metal_display_refresh_ns(void)
+{
+   uint64_t ns = 1000000000ull / 60;
+   CVDisplayLinkRef link;
+   if (CVDisplayLinkCreateWithActiveCGDisplays(&link) == kCVReturnSuccess) {
+      CVDisplayLinkSetCurrentCGDisplay(link, CGMainDisplayID());
+      const CVTime t = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(link);
+      if (!(t.flags & kCVTimeIsIndefinite) && t.timeValue > 0 && t.timeScale > 0)
+         ns = (uint64_t)((double)t.timeValue * 1e9 / (double)t.timeScale);
+      CVDisplayLinkRelease(link);
+   }
+   return ns;
+}
+
+#pragma clang diagnostic pop
