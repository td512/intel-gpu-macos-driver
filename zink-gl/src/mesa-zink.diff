+
+#define WSI_IOSURFACE_MIN_IMAGES 3
+#define WSI_IOSURFACE_MAX_IMAGES 8
+
+enum wsi_iosurface_image_state {
+   /* The application may acquire it once nobody else uses the IOSurface. */
+   WSI_IOSURFACE_IMAGE_FREE,
+   WSI_IOSURFACE_IMAGE_ACQUIRED,
+   /* Presented, waiting for a refresh (MAILBOX, FIFO). */
+   WSI_IOSURFACE_IMAGE_QUEUED,
+   /* The contents layer shows it. */
+   WSI_IOSURFACE_IMAGE_SHOWN,
+};
+
+struct wsi_iosurface_swapchain;
+
+struct wsi_iosurface_image {
+   struct wsi_image base;
+   /* Set before wsi_create_image(), which only clears base. */
+   struct wsi_iosurface_swapchain *chain;
+   void *iosurface;
+   uint32_t iosurface_id;
+   enum wsi_iosurface_image_state state;
+   uint64_t present_id;
+   /* Presented, its write fence not attached yet: that happens when it is
+    * shown, so a frame replaced before it was shown costs no kernel calls.
+    */
+   bool signal_pending;
+   /* Shown since the application last had it: the window server may still
+    * be reading it on the GPU (acquire waits for that).
+    */
+   bool idle_pending;
+   /* When it stopped being shown: the oldest free image is acquired first,
+    * the one the window server most likely let go of.
+    */
+   uint64_t retired;
+};
+
+struct wsi_iosurface_swapchain {
+   struct wsi_swapchain base;
+
+   VkIcdSurfaceMetal *surface;
+   VkExtent2D extent;
+   VkFormat format;
+   VkColorSpaceKHR color_space;
+   bool gpu_memory;
+   uint32_t bytes_per_row;
+
+   /* Images in the IOSurface's GPU memory (gpu_memory): linear at the
+    * IOSurface's row pitch, or `modifier` (Tile4) when the driver says
+    * every user of that memory handles it.
+    */
+   uint64_t modifier;
+   bool allow_tiled;
+   VkSubresourceLayout plane_layout;
+   VkImageDrmFormatModifierExplicitCreateInfoEXT drm_explicit;
+   VkImageDrmFormatModifierListCreateInfoEXT drm_list;
+
+   struct wsi_metal_contents_layer *contents;
+   struct wsi_metal_vblank *vblank;
+   struct wsi_metal_present_info *present_info;
+
+   mtx_t lock;
+   struct u_cnd_monotonic cond;
+   VkResult status;
+   uint64_t serial;
+   int32_t shown;
+   /* IMMEDIATE commits at most one frame per display refresh to Core
+    * Animation (the window server composites once per refresh anyway): a
+    * frame presented sooner after the last one waits for the next refresh,
+    * where the newest one wins.
+    */
+   uint64_t refresh_ns, last_show_ns;
+   /* Presented, not shown yet (FIFO, MAILBOX, IMMEDIATE within a refresh), oldest first */
+   uint32_t queue[WSI_IOSURFACE_MAX_IMAGES];
+   uint32_t queue_head, queue_count;
+
+   /* MESA_VK_WSI_FPS_LOG=<file>: a line every 2 s with the presents, shown
+    * and dropped frames per second and the time spent in acquire.
+    */
+   FILE *fps_log;
+   uint64_t fps_t0, fps_acquire_ns;
+   uint32_t fps_presents, fps_shown, fps_dropped;
+
+   struct wsi_iosurface_image images[0];
+};
+
+static struct wsi_image *
+wsi_iosurface_swapchain_get_wsi_image(struct wsi_swapchain *wsi_chain,
+                                      uint32_t image_index)
+{
+   struct wsi_iosurface_swapchain *chain =
+      (struct wsi_iosurface_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+static uint32_t
+wsi_iosurface_select_memory_type(const struct wsi_device *wsi,
+                                 uint32_t type_bits,
+                                 VkMemoryPropertyFlags want,
+                                 VkMemoryPropertyFlags avoid)
+{
+   u_foreach_bit(t, type_bits) {
+      const VkMemoryPropertyFlags flags = wsi->memory_props.memoryTypes[t].propertyFlags;
+      if ((flags & want) == want && !(flags & avoid))
+         return t;
+   }
+   u_foreach_bit(t, type_bits) {
+      const VkMemoryPropertyFlags flags = wsi->memory_props.memoryTypes[t].propertyFlags;
+      if ((flags & want) == want)
+         return t;
+   }
+   return ffs(type_bits) - 1;
+}
+
+/* gpu_memory: a new IOSurface, and the image's memory is its GPU memory. */
+static VkResult
+wsi_iosurface_create_gpu_mem(const struct wsi_swapchain *wsi_chain,
+                             const struct wsi_image_info *info,
+                             struct wsi_image *image)
+{
+   const struct wsi_device *wsi = wsi_chain->wsi;
+   struct wsi_iosurface_image *ios_image =
+      container_of(image, struct wsi_iosurface_image, base);
+   struct wsi_iosurface_swapchain *chain = ios_image->chain;
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(wsi_chain->device, image->image, &reqs);
+
+   const uint64_t alloc_size =
+      align64(MAX2(reqs.size, (uint64_t)chain->bytes_per_row *
+                              chain->extent.height), 4096);
+   ios_image->iosurface =
+      wsi_metal_iosurface_create(chain->extent.width, chain->extent.height,
+                                 chain->format, chain->color_space,
+                                 chain->bytes_per_row, alloc_size,
+                                 &ios_image->iosurface_id);
+   if (!ios_image->iosurface)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   /* A tiled image's layout, as the driver chose it */
+   uint32_t pitch = chain->bytes_per_row;
+   if (chain->modifier != 0 /* DRM_FORMAT_MOD_LINEAR */) {
+      const VkImageSubresource sub = {
+         .aspectMask = VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+      };
+      VkSubresourceLayout layout;
+      wsi->GetImageSubresourceLayout(wsi_chain->device, image->image, &sub,
+                                     &layout);
+      if (layout.offset != 0 || layout.rowPitch > UINT32_MAX)
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      pitch = layout.rowPitch;
+   }
+
+   const struct wsi_memory_allocate_info memory_wsi_info = {
+      .sType = VK_STRUCTURE_TYPE_WSI_MEMORY_ALLOCATE_INFO_MESA,
+      .iosurface_id = ios_image->iosurface_id,
+      .iosurface_modifier = chain->modifier,
+      .iosurface_pitch = pitch,
+      .iosurface_bytes_per_row = chain->bytes_per_row,
+   };
+   const VkMemoryDedicatedAllocateInfo dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &memory_wsi_info,
+      .image = image->image,
+   };
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &dedicated,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex =
+         wsi_iosurface_select_memory_type(wsi, reqs.memoryTypeBits,
+                                          VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+                                          VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT),
+   };
+   VkResult result = wsi->AllocateMemory(wsi_chain->device, &alloc_info,
+                                         &wsi_chain->alloc, &image->memory);
+   if (result != VK_SUCCESS)
+      return result;
+
+   image->num_planes = 1;
+   image->sizes[0] = reqs.size;
+   image->row_pitches[0] = pitch;
+   image->offsets[0] = 0;
+   image->drm_modifier = chain->modifier;
+   return VK_SUCCESS;
+}
+
+/* Buffer blit: the IOSurface's pages are the blit destination. */
+static uint8_t *
+wsi_iosurface_alloc_pages(struct wsi_image *image, unsigned size)
+{
+   struct wsi_iosurface_image *ios_image =
+      container_of(image, struct wsi_iosurface_image, base);
+   struct wsi_iosurface_swapchain *chain = ios_image->chain;
+
+   ios_image->iosurface =
+      wsi_metal_iosurface_create(chain->extent.width, chain->extent.height,
+                                 chain->format, chain->color_space,
+                                 chain->bytes_per_row, align(size, 4096),
+                                 &ios_image->iosurface_id);
+   if (!ios_image->iosurface)
+      return NULL;
+   return wsi_metal_iosurface_base_address(ios_image->iosurface);
+}
+
+static VkResult
+wsi_iosurface_create_pages_mem(const struct wsi_swapchain *chain,
+                               const struct wsi_image_info *info,
+                               struct wsi_image *image)
+{
+   VkResult result = wsi_create_buffer_blit_context(chain, info, image, 0);
+   if (result == VK_SUCCESS &&
+       !container_of(image, struct wsi_iosurface_image, base)->iosurface)
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+   return result;
+}
+
+static uint32_t
+wsi_iosurface_select_pages_memory_type(const struct wsi_device *wsi,
+                                       uint32_t type_bits)
+{
+   return wsi_iosurface_select_memory_type(wsi, type_bits,
+                                           VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                           VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                                           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+}
+
+static VkResult
+wsi_iosurface_configure_image(const struct wsi_swapchain *wsi_chain,
+                              const VkSwapchainCreateInfoKHR *pCreateInfo,
+                              const struct wsi_metal_image_params *params,
+                              struct wsi_image_info *info)
+{
+   const struct wsi_device *wsi = wsi_chain->wsi;
+   struct wsi_iosurface_swapchain *chain =
+      container_of((struct wsi_swapchain *)wsi_chain,
+                   struct wsi_iosurface_swapchain, base);
+
+   VkResult result = wsi_configure_image(wsi_chain, pCreateInfo, 0, info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (params->iosurface_pages) {
+      wsi_configure_buffer_image(wsi_chain, pCreateInfo,
+                                 256 /* stride_align */, 4096 /* size_align */,
+                                 info);
+      chain->bytes_per_row = info->linear_stride;
+      info->select_image_memory_type = wsi_select_device_memory_type;
+      info->select_blit_dst_memory_type = wsi_iosurface_select_pages_memory_type;
+      info->alloc_shm = wsi_iosurface_alloc_pages;
+      info->create_mem = wsi_iosurface_create_pages_mem;
+      return VK_SUCCESS;
+   }
+
+   /* The IOSurface's pages (CPU readers) are linear at this row pitch. */
+   const uint32_t cpp = vk_format_get_blocksize(pCreateInfo->imageFormat);
+   chain->bytes_per_row = align(pCreateInfo->imageExtent.width * cpp, 256);
+
+   /* Its GPU memory is tiled when every user of it handles the tiling (the
+    * driver says so): like a Linux compositor that takes the modifier, the
+    * application then renders and blits into a Tile4 image (4x faster into
+    * than linear on Xe2, 122 vs 30 us for a 2560x1302 blit).
+    */
+   chain->modifier = chain->allow_tiled && wsi->iosurface.gpu_memory_modifier ?
+      wsi->iosurface.gpu_memory_modifier(wsi_chain->device,
+                                         pCreateInfo->imageFormat) : 0;
+   if (chain->modifier != 0 /* DRM_FORMAT_MOD_LINEAR */) {
+      chain->drm_list = (VkImageDrmFormatModifierListCreateInfoEXT) {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+         .drmFormatModifierCount = 1,
+         .pDrmFormatModifiers = &chain->modifier,
+      };
+      info->create.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+      __vk_append_struct(&info->create, &chain->drm_list);
+      info->create_mem = wsi_iosurface_create_gpu_mem;
+      return VK_SUCCESS;
+   }
+
+   /* Linear at the IOSurface's row pitch: the same layout as its pages. */
+   chain->plane_layout = (VkSubresourceLayout) {
+      .offset = 0,
+      .rowPitch = chain->bytes_per_row,
+   };
+   chain->drm_explicit = (VkImageDrmFormatModifierExplicitCreateInfoEXT) {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+      .drmFormatModifier = 0, /* DRM_FORMAT_MOD_LINEAR */
+      .drmFormatModifierPlaneCount = 1,
+      .pPlaneLayouts = &chain->plane_layout,
+   };
+   info->create.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+   __vk_append_struct(&info->create, &chain->drm_explicit);
+   info->create_mem = wsi_iosurface_create_gpu_mem;
+   return VK_SUCCESS;
+}
+
+static bool
+wsi_iosurface_image_fence_done(struct wsi_iosurface_swapchain *chain,
+                               uint32_t index)
+{
+   VkFence fence = chain->base.fences[index];
+   return fence == VK_NULL_HANDLE ||
+          chain->base.wsi->GetFenceStatus(chain->base.device, fence) != VK_NOT_READY;
+}
+
+/* Make image `index` the contents of the layer. Called with chain->lock. */
+static void
+wsi_iosurface_show_locked(struct wsi_iosurface_swapchain *chain,
+                          uint32_t index)
+{
+   struct wsi_iosurface_image *image = &chain->images[index];
+   const struct wsi_device *wsi = chain->base.wsi;
+
+   /* The frame's fence becomes the IOSurface's write fence: the window
+    * server's GPU waits for it, nobody's CPU does.  If the driver could not
+    * attach it, wait here so the window server never reads a frame that is
+    * still being rendered.
+    */
+   if (image->signal_pending) {
+      VkFence fence = chain->base.fences[index];
+      if (wsi->iosurface.signal_write(chain->base.device, fence,
+                                      image->iosurface,
+                                      chain->gpu_memory) != VK_SUCCESS)
+         wsi->WaitForFences(chain->base.device, 1, &fence, true, UINT64_MAX);
+      image->signal_pending = false;
+   }
+   image->idle_pending = true;
+   chain->last_show_ns = os_time_get_nano();
+
+   if (chain->shown >= 0 && chain->shown != (int32_t)index) {
+      struct wsi_iosurface_image *old = &chain->images[chain->shown];
+      old->state = WSI_IOSURFACE_IMAGE_FREE;
+      old->retired = ++chain->serial;
+   }
+   image->state = WSI_IOSURFACE_IMAGE_SHOWN;
+   chain->shown = index;
+   chain->fps_shown++;
+
+   wsi_metal_contents_layer_set(chain->contents, image->iosurface);
+
+   if (image->present_id) {
+      struct wsi_metal_present_info *info = chain->present_info;
+      mtx_lock(&info->mutex);
+      if (image->present_id > info->present_id) {
+         info->present_id = image->present_id;
+         u_cnd_monotonic_broadcast(&info->present_id_cond);
+      }
+      mtx_unlock(&info->mutex);
+      image->present_id = 0;
+   }
+
+   u_cnd_monotonic_broadcast(&chain->cond);
+}
+
+static uint32_t
+wsi_iosurface_queue_pop_locked(struct wsi_iosurface_swapchain *chain)
+{
+   assert(chain->queue_count);
+   const uint32_t index = chain->queue[chain->queue_head];
+   chain->queue_head = (chain->queue_head + 1) % WSI_IOSURFACE_MAX_IMAGES;
+   chain->queue_count--;
+   return index;
+}
+
+/* A presented frame that will never be shown: back to the application. Its
+ * present ID is covered by the newer frame's.
+ */
+static void
+wsi_iosurface_drop_locked(struct wsi_iosurface_swapchain *chain,
+                          uint32_t index)
+{
+   struct wsi_iosurface_image *image = &chain->images[index];
+   image->state = WSI_IOSURFACE_IMAGE_FREE;
+   image->present_id = 0;
+   image->signal_pending = false;   /* never shown: nobody else reads it */
+   image->retired = ++chain->serial;
+   chain->fps_dropped++;
+   u_cnd_monotonic_broadcast(&chain->cond);
+}
+
+/* MAILBOX: queued frames older than the newest finished one will never be
+ * shown, so they go back to the application as soon as that one finished
+ * (not at the next refresh): the application keeps rendering ahead.
+ */
+static void
+wsi_iosurface_prune_locked(struct wsi_iosurface_swapchain *chain)
+{
+   if (chain->base.present_mode == VK_PRESENT_MODE_IMMEDIATE_KHR) {
+      /* The newest frame wins, finished or not (implicit sync). */
+      while (chain->queue_count > 1)
+         wsi_iosurface_drop_locked(chain, wsi_iosurface_queue_pop_locked(chain));
+      return;
+   }
+   if (chain->base.present_mode != VK_PRESENT_MODE_MAILBOX_KHR)
+      return;
+
+   int32_t newest_done = -1;
+   for (uint32_t k = 0; k < chain->queue_count; k++) {
+      const uint32_t index =
+         chain->queue[(chain->queue_head + k) % WSI_IOSURFACE_MAX_IMAGES];
+      if (wsi_iosurface_image_fence_done(chain, index))
+         newest_done = k;
+   }
+   for (int32_t k = 0; k < newest_done; k++)
+      wsi_iosurface_drop_locked(chain, wsi_iosurface_queue_pop_locked(chain));
+}
+
+/* The display link's refresh: latch a frame whose rendering is done. FIFO:
+ * the oldest queued one. MAILBOX: the newest finished one.
+ */
+static void
+wsi_iosurface_vblank(void *data)
+{
+   struct wsi_iosurface_swapchain *chain = data;
+
+   mtx_lock(&chain->lock);
+   if (chain->status == VK_SUCCESS && chain->queue_count) {
+      wsi_iosurface_prune_locked(chain);
+      if (chain->base.present_mode == VK_PRESENT_MODE_IMMEDIATE_KHR ||
+          wsi_iosurface_image_fence_done(chain, chain->queue[chain->queue_head]))
+         wsi_iosurface_show_locked(chain, wsi_iosurface_queue_pop_locked(chain));
+   }
+   mtx_unlock(&chain->lock);
+}
+
+static VkResult
+wsi_iosurface_start_vblank_locked(struct wsi_iosurface_swapchain *chain)
+{
+   if (chain->vblank)
+      return VK_SUCCESS;
+   chain->vblank = wsi_metal_vblank_start(wsi_iosurface_vblank, chain);
+   return chain->vblank ? VK_SUCCESS : VK_ERROR_SURFACE_LOST_KHR;
+}
+
+static void
+wsi_iosurface_swapchain_set_present_mode(struct wsi_swapchain *wsi_chain,
+                                         VkPresentModeKHR mode)
+{
+   struct wsi_iosurface_swapchain *chain =
+      (struct wsi_iosurface_swapchain *)wsi_chain;
+
+   mtx_lock(&chain->lock);
+   chain->base.present_mode = mode;
+   mtx_unlock(&chain->lock);
+}
+
+static VkResult
+wsi_iosurface_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
+                                      uint32_t image_index,
+                                      uint64_t present_id,
+                                      const VkPresentRegionKHR *damage)
+{
+   struct wsi_iosurface_swapchain *chain =
+      (struct wsi_iosurface_swapchain *)wsi_chain;
+   struct wsi_iosurface_image *image = &chain->images[image_index];
+   VkResult result = VK_SUCCESS;
+
+   mtx_lock(&chain->lock);
+   image->signal_pending = true;   /* attached when it is shown */
+   if (chain->status != VK_SUCCESS) {
+      result = chain->status;
+      image->state = WSI_IOSURFACE_IMAGE_FREE;
+      mtx_unlock(&chain->lock);
+      return result;
+   }
+
+   image->present_id = chain->base.present_wait_enabled ? present_id : 0;
+
+   if (chain->base.present_mode == VK_PRESENT_MODE_IMMEDIATE_KHR &&
+       os_time_get_nano() - chain->last_show_ns >= chain->refresh_ns) {
+      /* Frames still queued (within the last refresh, or from before a
+       * switch to IMMEDIATE) are behind this one.
+       */
+      while (chain->queue_count)
+         wsi_iosurface_drop_locked(chain, wsi_iosurface_queue_pop_locked(chain));
+      wsi_iosurface_show_locked(chain, image_index);
+   } else {
+      assert(chain->queue_count < WSI_IOSURFACE_MAX_IMAGES);
+      chain->queue[(chain->queue_head + chain->queue_count) %
+                   WSI_IOSURFACE_MAX_IMAGES] = image_index;
+      chain->queue_count++;
+      image->state = WSI_IOSURFACE_IMAGE_QUEUED;
+      wsi_iosurface_prune_locked(chain);
+      result = wsi_iosurface_start_vblank_locked(chain);
+   }
+
+   if (chain->fps_log) {
+      chain->fps_presents++;
+      const uint64_t now = os_time_get_nano();
+      if (!chain->fps_t0) {
+         chain->fps_t0 = now;
+      } else if (now - chain->fps_t0 >= 2000000000ull) {
+         const double s = (now - chain->fps_t0) / 1e9;
+         static const char *const mode_names[] = {
+            "IMMEDIATE", "MAILBOX", "FIFO", "FIFO_RELAXED",
+         };
+         fprintf(chain->fps_log,
+                 "%.3f pid %d %ux%u %s %u images (%s): %.1f presents/s, "
+                 "%.1f shown/s, %.1f dropped/s, acquire %.3f ms/frame\n",
+                 now / 1e9, (int)getpid(), chain->extent.width,
+                 chain->extent.height,
+                 chain->base.present_mode < 4 ?
+                    mode_names[chain->base.present_mode] : "?",
+                 chain->base.image_count,
+                 !chain->gpu_memory ? "page copies" :
+                 chain->modifier ? "shared VRAM, Tile4" : "shared VRAM, linear",
+                 chain->fps_presents / s, chain->fps_shown / s,
+                 chain->fps_dropped / s,
+                 chain->fps_presents ?
+                    chain->fps_acquire_ns / 1e6 / chain->fps_presents : 0.0);
+         fflush(chain->fps_log);
+         chain->fps_t0 = now;
+         chain->fps_presents = chain->fps_shown = chain->fps_dropped = 0;
+         chain->fps_acquire_ns = 0;
+      }
+   }
+   mtx_unlock(&chain->lock);
+
+   if (result != VK_SUCCESS)
+      return result;
+
+   uint32_t width = 0, height = 0;
+   wsi_metal_layer_size(chain->surface->pLayer, &width, &height);
+   return (width == chain->extent.width && height == chain->extent.height) ?
+          VK_SUCCESS : VK_SUBOPTIMAL_KHR;
+}
+
+static VkResult
+wsi_iosurface_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
+                                           const VkAcquireNextImageInfoKHR *info,
+                                           uint32_t *image_index)
+{
+   struct wsi_iosurface_swapchain *chain =
+      (struct wsi_iosurface_swapchain *)wsi_chain;
+   const struct wsi_device *wsi = chain->base.wsi;
+   const uint64_t abs_timeout = info->timeout == UINT64_MAX ? UINT64_MAX :
+                                os_time_get_absolute_timeout(info->timeout);
+   const uint64_t acquire_t0 = chain->fps_log ? os_time_get_nano() : 0;
+   int32_t best;
+
+   mtx_lock(&chain->lock);
+   for (;;) {
+      if (chain->status != VK_SUCCESS) {
+         mtx_unlock(&chain->lock);
+         return chain->status;
+      }
+
+      /* MAILBOX frames overtaken by a finished one come back now. */
+      wsi_iosurface_prune_locked(chain);
+
+      bool in_use = chain->base.present_mode == VK_PRESENT_MODE_MAILBOX_KHR &&
+                    chain->queue_count > 1;
+      best = -1;
+      for (uint32_t i = 0; i < chain->base.image_count; i++) {
+         struct wsi_iosurface_image *image = &chain->images[i];
+         if (image->state != WSI_IOSURFACE_IMAGE_FREE)
+            continue;
+         if (wsi_metal_iosurface_in_use(image->iosurface)) {
+            in_use = true;
+            continue;
+         }
+         if (best < 0 || image->retired < chain->images[best].retired)
+            best = i;
+      }
+      if (best >= 0)
+         break;
+
+      /* IMMEDIATE never waits for a refresh: a frame held back to coalesce
+       * commits goes out now when the application needs an image (showing
+       * it lets the window server drop the one before).
+       */
+      if (chain->base.present_mode == VK_PRESENT_MODE_IMMEDIATE_KHR &&
+          chain->queue_count) {
+         wsi_iosurface_prune_locked(chain);
+         wsi_iosurface_show_locked(chain, wsi_iosurface_queue_pop_locked(chain));
+         continue;
+      }
+
+      if (info->timeout == 0) {
+         mtx_unlock(&chain->lock);
+         return VK_NOT_READY;
+      }
+      const uint64_t now = os_time_get_nano();
+      if (now >= abs_timeout) {
+         mtx_unlock(&chain->lock);
+         return VK_TIMEOUT;
+      }
+
+      /* Images the window server still holds, and MAILBOX frames waiting
+       * to be overtaken, come back without a wake-up: poll for them;
+       * anything else (a frame shown) wakes us.
+       */
+      uint64_t until = in_use ? MIN2(abs_timeout, now + 50 * 1000) : abs_timeout;
+      if (until == UINT64_MAX) {
+         u_cnd_monotonic_wait(&chain->cond, &chain->lock);
+      } else {
+         struct timespec ts;
+         timespec_from_nsec(&ts, until);
+         u_cnd_monotonic_timedwait(&chain->cond, &chain->lock, &ts);
+      }
+   }
+   struct wsi_iosurface_image *image = &chain->images[best];
+   image->state = WSI_IOSURFACE_IMAGE_ACQUIRED;
+   mtx_unlock(&chain->lock);
+
+   /* The window server's last GPU reads of the IOSurface, if it was shown
+    * since (a frame replaced before it was shown was never read).
+    */
+   VkResult result = !image->idle_pending ? VK_SUCCESS :
+      wsi->iosurface.wait_idle(chain->base.device, image->iosurface,
+                               info->timeout == 0 ? 0 : abs_timeout);
+   if (result == VK_SUCCESS)
+      image->idle_pending = false;
+   if (result != VK_SUCCESS) {
+      mtx_lock(&chain->lock);
+      image->state = WSI_IOSURFACE_IMAGE_FREE;
+      mtx_unlock(&chain->lock);
+      if (result == VK_TIMEOUT && info->timeout == 0)
+         result = VK_NOT_READY;
+      return result;
+   }
+
+   *image_index = best;
+   if (chain->fps_log) {
+      mtx_lock(&chain->lock);
+      chain->fps_acquire_ns += os_time_get_nano() - acquire_t0;
+      mtx_unlock(&chain->lock);
+   }
+
+   uint32_t width = 0, height = 0;
+   wsi_metal_layer_size(chain->surface->pLayer, &width, &height);
+   return (width == chain->extent.width && height == chain->extent.height) ?
+          VK_SUCCESS : VK_SUBOPTIMAL_KHR;
+}
+
+static VkResult
+wsi_iosurface_swapchain_release_images(struct wsi_swapchain *wsi_chain,
+                                       uint32_t count, const uint32_t *indices)
+{
+   struct wsi_iosurface_swapchain *chain =
+      (struct wsi_iosurface_swapchain *)wsi_chain;
+
+   mtx_lock(&chain->lock);
+   for (uint32_t i = 0; i < count; i++) {
+      struct wsi_iosurface_image *image = &chain->images[indices[i]];
+      assert(image->state == WSI_IOSURFACE_IMAGE_ACQUIRED);
+      image->state = WSI_IOSURFACE_IMAGE_FREE;
+   }
+   u_cnd_monotonic_broadcast(&chain->cond);
+   mtx_unlock(&chain->lock);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_iosurface_swapchain_wait_for_present(struct wsi_swapchain *wsi_chain,
+                                         uint64_t waitValue,
+                                         uint64_t timeout)
+{
+   struct wsi_iosurface_swapchain *chain =
+      (struct wsi_iosurface_swapchain *)wsi_chain;
+   struct wsi_metal_present_info *present_info = chain->present_info;
+
+   /* The present's submission first (its semaphore). */
+   VkResult result = wsi_swapchain_wait_for_present_semaphore(
+      &chain->base, waitValue, timeout);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct timespec abs_timespec;
+   timespec_from_nsec(&abs_timespec, timeout == 0 ? 0 :
+                      os_time_get_absolute_timeout(timeout));
+
+   mtx_lock(&present_info->mutex);
+   while (present_info->present_id < waitValue) {
+      int ret = u_cnd_monotonic_timedwait(&present_info->present_id_cond,
+                                          &present_info->mutex,
+                                          &abs_timespec);
+      if (ret == thrd_timedout) {
+         result = VK_TIMEOUT;
+         break;
+      }
+      if (ret != thrd_success) {
+         result = VK_ERROR_DEVICE_LOST;
+         break;
+      }
+   }
+   mtx_unlock(&present_info->mutex);
+   return result;
+}
+
+static void
+wsi_iosurface_destroy_images(struct wsi_iosurface_swapchain *chain,
+                             uint32_t count)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      struct wsi_iosurface_image *image = &chain->images[i];
+      wsi_destroy_image(&chain->base, &image->base);
+      /* Core Animation keeps the IOSurface it shows (and the GPU memory
+       * behind it) until the next swapchain's first frame replaces it.
+       */
+      wsi_metal_iosurface_release(image->iosurface);
+      image->iosurface = NULL;
+   }
+}
+
+static VkResult
+wsi_iosurface_swapchain_destroy(struct wsi_swapchain *wsi_chain,
+                                const VkAllocationCallbacks *pAllocator)
+{
+   struct wsi_iosurface_swapchain *chain =
+      (struct wsi_iosurface_swapchain *)wsi_chain;
+
+   mtx_lock(&chain->lock);
+   chain->status = VK_ERROR_OUT_OF_DATE_KHR;
+   u_cnd_monotonic_broadcast(&chain->cond);
+   mtx_unlock(&chain->lock);
+
+   /* After this no refresh tick runs. */
+   wsi_metal_vblank_stop(chain->vblank);
+
+   wsi_iosurface_destroy_images(chain, chain->base.image_count);
+   wsi_metal_contents_layer_put(chain->contents);
+   if (chain->fps_log)
+      fclose(chain->fps_log);
+   wsi_metal_release_present_info(chain->present_info);
+   u_cnd_monotonic_destroy(&chain->cond);
+   mtx_destroy(&chain->lock);
+   wsi_swapchain_finish(&chain->base);
+   vk_free(pAllocator, chain);
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_iosurface_create_swapchain(VkIcdSurfaceMetal *metal_surface,
+                               VkDevice device,
+                               struct wsi_device *wsi_device,
+                               const VkSwapchainCreateInfoKHR *pCreateInfo,
+                               const VkAllocationCallbacks *pAllocator,
+                               bool gpu_memory, bool allow_tiled,
+                               struct wsi_swapchain **swapchain_out)
+{
+   /* MAILBOX holds a finished frame for the next refresh, and IMMEDIATE
+    * one presented within a refresh of the last commit, next to the shown
+    * one and the one the window server is letting go of: a fourth image
+    * lets the application keep rendering meanwhile (with three, MAILBOX
+    * waits for each frame's GPU work, ~4x slower measured, and IMMEDIATE
+    * for the window server).  Creating more images than minImageCount is
+    * allowed.
+    */
+   const VkPresentModeKHR mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   const uint32_t min_images =
+      (mode == VK_PRESENT_MODE_MAILBOX_KHR || mode == VK_PRESENT_MODE_IMMEDIATE_KHR) ?
+         4 : WSI_IOSURFACE_MIN_IMAGES;
+   const uint32_t num_images = CLAMP(pCreateInfo->minImageCount, min_images,
+                                     WSI_IOSURFACE_MAX_IMAGES);
+   VkResult result;
+
+   if (!wsi_metal_iosurface_format_supported(pCreateInfo->imageFormat,
+                                             pCreateInfo->imageColorSpace))
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   struct wsi_iosurface_swapchain *chain;
+   const size_t size = sizeof(*chain) + num_images * sizeof(chain->images[0]);
+   chain = vk_zalloc(pAllocator, size, 8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (chain == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   /* Read by wsi_iosurface_configure_image() from wsi_swapchain_init(). */
+   chain->surface = metal_surface;
+   chain->extent = pCreateInfo->imageExtent;
+   chain->format = pCreateInfo->imageFormat;
+   chain->color_space = pCreateInfo->imageColorSpace;
+   chain->gpu_memory = gpu_memory;
+   chain->allow_tiled = allow_tiled;
+
+   const struct wsi_metal_image_params params = {
+      .base.image_type = WSI_IMAGE_TYPE_METAL,
+      .iosurface = true,
+      .iosurface_pages = !gpu_memory,
+   };
+   result = wsi_swapchain_init(wsi_device, &chain->base, device,
+                               pCreateInfo, &params.base, pAllocator);
+   if (result != VK_SUCCESS)
+      goto fail_chain_alloc;
+
+   chain->base.destroy = wsi_iosurface_swapchain_destroy;
+   chain->base.get_wsi_image = wsi_iosurface_swapchain_get_wsi_image;
+   chain->base.acquire_next_image = wsi_iosurface_swapchain_acquire_next_image;
+   chain->base.release_images = wsi_iosurface_swapchain_release_images;
+   chain->base.set_present_mode = wsi_iosurface_swapchain_set_present_mode;
+   chain->base.queue_present = wsi_iosurface_swapchain_queue_present;
+   chain->base.wait_for_present = wsi_iosurface_swapchain_wait_for_present;
+   chain->base.wait_for_present2 = wsi_iosurface_swapchain_wait_for_present;
+   chain->base.present_mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   chain->base.image_count = num_images;
+   chain->shown = -1;
+   /* At most one Core Animation commit per refresh; the period is halved so
+    * a frame right after a refresh still makes the next composite.
+    */
+   chain->refresh_ns = wsi_metal_display_refresh_ns() / 2;
+
+   if (mtx_init(&chain->lock, mtx_plain) != thrd_success) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail_init;
+   }
+   if (u_cnd_monotonic_init(&chain->cond) != thrd_success) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail_lock;
+   }
+
+   chain->present_info = wsi_metal_create_present_info();
+   if (chain->present_info == NULL) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail_cond;
+   }
+
+   uint32_t created = 0;
+   for (; created < num_images; created++) {
+      struct wsi_iosurface_image *image = &chain->images[created];
+      image->chain = chain;
+      result = wsi_create_image(&chain->base, &chain->base.image_info,
+                                &image->base);
+      if (result != VK_SUCCESS) {
+         wsi_metal_iosurface_release(image->iosurface);
+         image->iosurface = NULL;
+         goto fail_images;
+      }
+   }
+
+   const char *fps_log = os_get_option("MESA_VK_WSI_FPS_LOG");
+   if (fps_log && fps_log[0])
+      chain->fps_log = fopen(fps_log, "a");
+
+   chain->contents =
+      wsi_metal_contents_layer_get(metal_surface->pLayer,
+                                   pCreateInfo->compositeAlpha &
+                                   VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR);
+   if (!chain->contents) {
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
+      goto fail_images;
+   }
+
+   *swapchain_out = &chain->base;
+   return VK_SUCCESS;
+
+fail_images:
+   if (chain->fps_log)
+      fclose(chain->fps_log);
+   wsi_iosurface_destroy_images(chain, created);
+   wsi_metal_release_present_info(chain->present_info);
+fail_cond:
+   u_cnd_monotonic_destroy(&chain->cond);
+fail_lock:
+   mtx_destroy(&chain->lock);
+fail_init:
+   wsi_swapchain_finish(&chain->base);
+fail_chain_alloc:
+   vk_free(pAllocator, chain);
+   return result;
+}
+
+static VkResult
+wsi_iosurface_surface_create_swapchain(VkIcdSurfaceMetal *metal_surface,
+                                       VkDevice device,
+                                       struct wsi_device *wsi_device,
+                                       const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                       const VkAllocationCallbacks *pAllocator,
+                                       struct wsi_swapchain **swapchain_out)
+{
+   VkResult result = VK_ERROR_FEATURE_NOT_PRESENT;
+
+   if (!wsi_metal_iosurface_format_supported(pCreateInfo->imageFormat,
+                                             pCreateInfo->imageColorSpace))
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   /* MESA_VK_WSI_DEBUG=buffer: always copy into the pages. */
+   if (!(WSI_DEBUG & WSI_DEBUG_BUFFER) &&
+       wsi_device->iosurface.supports_gpu_memory(device)) {
+      /* Tile4 when every user of the GPU memory reads it (the driver says),
+       * else, or if that fails, linear GPU memory.
+       */
+      result = wsi_iosurface_create_swapchain(metal_surface, device, wsi_device,
+                                              pCreateInfo, pAllocator,
+                                              true, true, swapchain_out);
+      if (result == VK_SUCCESS)
+         return result;
+      result = wsi_iosurface_create_swapchain(metal_surface, device, wsi_device,
+                                              pCreateInfo, pAllocator,
+                                              true, false, swapchain_out);
+      if (result == VK_SUCCESS)
+         return result;
+   }
+
+   /* No shared GPU memory (the kernel switch is off, or its budget is
+    * spent): copy into the IOSurfaces' pages.
+    */
+   return wsi_iosurface_create_swapchain(metal_surface, device, wsi_device,
+                                         pCreateInfo, pAllocator,
+                                         false, false, swapchain_out);
+}
